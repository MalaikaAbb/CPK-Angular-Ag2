# Copy to `.env` here (backend/main.py finds it via python-dotenv) or export
# each variable in the shell that starts the process that reads it.

# ---------------------------------------------------------------------------
# backend/main.py — the AG2 agent (python-dotenv)
# ---------------------------------------------------------------------------

# REQUIRED. The model key. Only the AG2 process ever holds it; it never
# reaches the browser and never reaches the Copilot Runtime.
OPENAI_API_KEY=sk-...

# Model for the AG2 agent. Default: gpt-4o-mini
OPENAI_CHAT_MODEL_ID=gpt-4o-mini

# Seconds the getWeather tool sleeps before returning. Default: 1.5
# Without it the tool returns in a few ms — about one frame — so a tool
# renderer's "in-progress" state never gets painted and only the completed
# card is ever visible. Set to 0 for a tool that returns instantly.
WEATHER_TOOL_DELAY=1.5

# ---------------------------------------------------------------------------
# Copilot Runtime — frontend/server.ts, read from the shell that starts it
# ---------------------------------------------------------------------------

# Where the runtime finds the AG2 agent's AG-UI mount.
# Default: http://localhost:8000/weather/
# The trailing slash matters: Starlette redirects /weather to /weather/.
# Use 127.0.0.1 instead of localhost if DNS resolves to IPv6 while the agent
# binds IPv4.
AG2_AGENT_URL=http://localhost:8000/weather/

# Where the runtime finds the Sub-Agents supervisor (backend/subagents/main.py,
# a separate process pinned to ag2<1.0). Default:
# http://localhost:8001/subagents/ — same trailing-slash rule.
AG2_SUBAGENTS_URL=http://localhost:8001/subagents/

# REQUIRED. CopilotKit Intelligence key — put it in `frontend/.env`, which
# frontend/server.ts loads itself (this root .env is read only by the AG2
# process). The runtime refuses to start without it. The key scopes the
# Intelligence project, so use this project's own key.
# CPK_INTELLIGENCE_API_KEY=

# Port the Copilot Runtime listens on. Default: 8200.
# The Angular app's runtimeUrl in src/app/app.config.ts is hardcoded to 8200,
# so change both together.
PORT=8200

# Opt out of CopilotKit's anonymous runtime telemetry.
# COPILOTKIT_TELEMETRY_DISABLED=true
